---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Exam from '../../../components/Exam';
import { getCourses, getExam, coursePath, withBase, type Course, type Exam as ExamEntry } from '../../../lib/course';

export async function getStaticPaths() {
  const courses = await getCourses();
  const paths = [];
  for (const course of courses) {
    const exam = await getExam(course);
    if (exam) paths.push({ params: { course: course.id }, props: { course, exam } });
  }
  return paths;
}

interface Props { course: Course; exam: ExamEntry }

const { course, exam } = Astro.props;
const { Content } = await render(exam);
const { title, minutes, passMark, questions } = exam.data;
---

<Base title={`${title} · ${course.data.title}`} description={`Exam for ${course.data.title}`}>
  <article class="examhead shell">
    <p class="eyebrow"><a href={coursePath(course.id)}>{course.data.title}</a></p>
    <h1>{title}</h1>
    <p class="examhead__facts">
      {questions.length} questions · {passMark}% to pass{minutes && ` · about ${minutes} minutes`}
    </p>
    <div class="prose"><Content /></div>
    <Exam client:load courseId={course.id} courseTitle={course.data.title} title={title}
      skillHref={withBase('/skills/review-exam-results/SKILL.md')} minutes={minutes} passMark={passMark} questions={questions} />
  </article>
</Base>

<style>
  .examhead { padding: 3rem 1.25rem 4rem; max-width: 46rem; margin-inline: auto; }
  .examhead .eyebrow a { color: inherit; text-decoration: none; }
  .examhead .eyebrow a:hover { color: var(--accent); }
  .examhead h1 { margin: 0.4rem 0 0.5rem; }
  .examhead__facts { margin: 0 0 1.25rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-faint); }
  .examhead .prose { margin-bottom: 1.75rem; }
</style>
