---
import Base from '../../../layouts/Base.astro';
import CourseProgress from '../../../components/CourseProgress';
import { getCourses, getSteps, groupIntoSections, conceptPath, type Step, type Course } from '../../../lib/course';

export async function getStaticPaths() {
  const courses = await getCourses();
  return Promise.all(
    courses.map(async (course) => ({
      params: { course: course.id },
      props: { course, steps: await getSteps(course) },
    })),
  );
}

interface Props { course: Course; steps: Step[] }

const { course, steps } = Astro.props;
const sections = groupIntoSections(course, steps);
const withQuestions = steps.filter((s) => s.concept.data.questions.length > 0).length;
const highlighted = steps.filter((s) => s.concept.data.highlight).length;
---

<Base title={course.data.title} description={course.data.summary}>
  <div class="coursehead shell">
    <p class="eyebrow"><a href="/">All courses</a></p>
    <h1>{course.data.title}</h1>

    {(course.data.code || course.data.term || course.data.crn) && (
      <p class="coursehead__ident">
        {course.data.code && <span class="coursehead__code">{course.data.code}</span>}
        {course.data.term && <span>{course.data.term}</span>}
        {course.data.crn && <span>CRN {course.data.crn}</span>}
      </p>
    )}

    <p class="coursehead__summary">{course.data.summary}</p>

    {steps.length > 0 && (
      <div class="coursehead__meta">
        <CourseProgress client:load courseId={course.id} total={steps.length} resettable />
        {withQuestions > 0 && (
          <p class="coursehead__checks">
            {withQuestions} knowledge checks{highlighted > 0 && ` · ${highlighted} key concepts`}
          </p>
        )}
      </div>
    )}

    {steps.length > 0 && (
      <a class="btn btn--primary" href={conceptPath(course.id, 1)}>Start the course →</a>
    )}
  </div>

  <div class="contents shell">
    {sections.map((section) => (
      <section class="section">
        {section.title && (
          <header class="section__head">
            <h2 class="section__title">{section.title}</h2>
            {section.summary && <p class="section__summary">{section.summary}</p>}
          </header>
        )}

        <ol class="toc">
          {section.steps.map(({ concept, number }) => (
            <li class="toc__item">
              <a class="toc__link" href={conceptPath(course.id, number)}>
                <span class="toc__num">{String(number).padStart(2, '0')}</span>
                <span class="toc__title">{concept.data.title}</span>
                <span class="toc__tags">
                  {concept.data.highlight && <span class="tag tag--key">key</span>}
                  {concept.data.visuals.some((v) => v.type === 'animation') && (
                    <span class="tag tag--anim">animated</span>
                  )}
                  {concept.data.questions.length > 0 && <span class="tag">check</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    {steps.length === 0 && (
      <p class="empty">
        No concepts yet. Import source material with <code>npm run import:pdf</code>, or add a
        file under <code>src/content/concepts/{course.id}/</code>.
      </p>
    )}
  </div>
</Base>

<style>
  .coursehead { padding: 3rem 1.25rem 2rem; max-width: 46rem; margin-inline: 0; }
  .coursehead .eyebrow a { color: inherit; text-decoration: none; }
  .coursehead .eyebrow a:hover { color: var(--accent); }
  .coursehead h1 { margin: 0.4rem 0 0.75rem; }
  .coursehead__ident {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
  }
  .coursehead__ident > * + *::before { content: '·'; margin-right: 0.75rem; color: var(--line-strong); }
  .coursehead__code { color: var(--accent); font-weight: 600; }

  .coursehead__summary { color: var(--ink-soft); font-size: 1.05rem; margin: 0 0 1.5rem; }
  .coursehead__meta { max-width: 22rem; margin-bottom: 1.5rem; }
  .coursehead__checks { margin: 0.35rem 0 0; font-size: 0.78rem; color: var(--ink-faint); }

  .contents { padding: 0 1.25rem 3rem; max-width: 52rem; margin-inline: 0; }

  .section + .section { margin-top: 2.5rem; }
  .section__head { margin-bottom: 0.6rem; }
  .section__title { font-size: 1.05rem; margin: 0 0 0.2rem; }
  .section__summary { margin: 0; color: var(--ink-faint); font-size: 0.88rem; max-width: 38rem; }

  .toc { list-style: none; margin: 0; padding: 0; }
  .toc__item { border-top: 1px solid var(--line); }
  .toc__item:last-child { border-bottom: 1px solid var(--line); }

  .toc__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s, padding-left 0.15s;
  }
  .toc__link:hover { background: var(--bg-raised); padding-left: 0.9rem; }

  .toc__num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-faint); }
  .toc__title { flex: 1; font-weight: 500; }
  .toc__tags { display: flex; gap: 0.35rem; }

  .tag {
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line-strong);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  .tag--anim { color: var(--accent); border-color: var(--accent); }

  /* Filled rather than outlined, so it reads as a level above the other tags. */
  .tag--key {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg-raised);
    font-weight: 600;
  }

  .empty { color: var(--ink-soft); }
</style>
