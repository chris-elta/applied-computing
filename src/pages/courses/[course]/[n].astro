---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ConceptStage from '../../../components/ConceptStage.astro';
import Quiz from '../../../components/Quiz';
import NotationKey from '../../../components/NotationKey.astro';
import { shuffleChoices } from '../../../lib/shuffle-choices';
import Prerequisites from '../../../components/Prerequisites.astro';
import { getCourses, getSteps, groupIntoSections, conceptPath, coursePath, type Step } from '../../../lib/course';

export async function getStaticPaths() {
  const courses = await getCourses();
  const paths = [];
  for (const course of courses) {
    for (const step of await getSteps(course)) {
      paths.push({ params: { course: course.id, n: String(step.number) }, props: { step } });
    }
  }
  return paths;
}

interface Props { step: Step }

const { step } = Astro.props;
const { concept, course, number, total, prev, next } = step;
const steps = await getSteps(course);
const { Content } = await render(concept);

const section = course.data.sections.find((s) => s.id === concept.data.section);
const prevHref = prev ? conceptPath(course.id, number - 1) : coursePath(course.id);
const nextHref = next ? conceptPath(course.id, number + 1) : coursePath(course.id);
const prerequisites = concept.data.prerequisites.map((p) => {
  const target = p.see ? steps.find((s) => s.concept.id === p.see!.id) : undefined;
  return {
    topic: p.topic,
    explains: p.explains,
    href: target ? conceptPath(course.id, target.number) : undefined,
    seeTitle: target?.concept.data.title,
  };
});
const isLater = (v: (typeof concept.data.visuals)[number]) => v.type === 'animation' && v.placement === 'after-notation';
const topVisuals = concept.data.visuals.filter((v) => !isLater(v));
const laterVisuals = concept.data.visuals.filter(isLater);
const percent = Math.round((number / total) * 100);
const sections = groupIntoSections(course, steps);
---

<Base title={concept.data.title} description={course.data.summary}>
  <nav class="conceptbar" aria-label="Concept navigation">
    <div class="shell conceptbar__inner">
      <span class="conceptbar__where">
        <a href={coursePath(course.id)}>{course.data.title}</a>
        {section && <span class="conceptbar__section">{section.title}</span>}
      </span>
      <span class="conceptbar__steps">
        <a class="conceptbar__step" href={prevHref} rel="prev"
           title={`${prev ? `Previous: ${prev.data.title}` : 'Back to contents'} (←)`}
           aria-label={prev ? `Previous: ${prev.data.title}` : 'Back to contents'}>←</a>
        <button class="conceptbar__count" type="button" popovertarget="concept-contents"
                title="Jump to another concept in this course">
          {number} / {total} <span aria-hidden="true">▾</span>
        </button>
        <a class="conceptbar__step" href={nextHref} rel="next"
           title={`${next ? `Next: ${next.data.title}` : 'Finish course'} (→)`}
           aria-label={next ? `Next: ${next.data.title}` : 'Finish course'}>→</a>
      </span>
    </div>
    <div class="progress" role="progressbar" aria-valuenow={number} aria-valuemin={1} aria-valuemax={total}
         aria-label={`Concept ${number} of ${total}`}>
      <div class="progress__fill" style={`width:${percent}%`} />
    </div>
  </nav>

  <div class="jump" id="concept-contents" popover data-jump>
    <a class="jump__course" href={coursePath(course.id)}>{course.data.title} — contents</a>
    {sections.map((s) => (
      <section class="jump__section">
        {s.title && <h2 class="jump__title">{s.title}</h2>}
        <ol class="jump__list">
          {s.steps.map((st) => (
            <li>
              <a class="jump__link" href={conceptPath(course.id, st.number)} data-n={st.number}
                 aria-current={st.number === number ? 'page' : undefined}>
                <span class="jump__num">{String(st.number).padStart(2, '0')}</span>
                <span>{st.concept.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <article class="concept shell" data-concept data-course={course.id} data-number={number}
           data-prev={prevHref} data-next={nextHref}>
    {(concept.data.highlight || concept.data.assessed.length > 0) && (
      <p class="concept__badges">
        {concept.data.highlight && <span class="concept__key">key concept</span>}
        {concept.data.assessed.length > 0 && (
          <span class="concept__assessed" title={`Assessed in ${concept.data.assessed.join(', ')}`}>assessed</span>
        )}
      </p>
    )}

    <h1>{concept.data.title}</h1>

    <ConceptStage visuals={topVisuals} title={concept.data.title} />

    {prerequisites.length > 0 && (
      <div class="concept__prereq">
        <Prerequisites items={prerequisites} assessed={concept.data.assessed} />
      </div>
    )}

    {concept.data.notation.length > 0 && (
      <div class="concept__notation">
        <NotationKey entries={concept.data.notation} />
      </div>
    )}

    {laterVisuals.length > 0 && (
      <div class="concept__later-visuals">
        <ConceptStage visuals={laterVisuals} title={concept.data.title} />
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {concept.data.questions.length > 0 && (
      <div class="concept__quiz">
        <Quiz client:visible courseId={course.id} conceptNumber={number} questions={shuffleChoices(concept.data.questions)} />
      </div>
    )}

    <nav class="concept__nav">
      <a class="btn" href={prevHref} rel="prev">← {prev ? prev.data.title : 'Contents'}</a>
      <a class="btn btn--primary" href={nextHref} rel="next">{next ? next.data.title : 'Finish course'} →</a>
    </nav>
  </article>

  <script>
    import { markSeen, getCourseProgress } from '../../../lib/progress';

    // Module scope survives view transitions, so the keydown listener is bound
    // once and simply reads whatever the current concept advertises.
    let nav: { prev: string; next: string } | null = null;

    const init = () => {
      const el = document.querySelector<HTMLElement>('[data-concept]');
      if (!el) { nav = null; return; }
      nav = { prev: el.dataset.prev ?? '', next: el.dataset.next ?? '' };
      const course = el.dataset.course ?? '';
      markSeen(course, Number(el.dataset.number));

      const jump = document.querySelector<HTMLElement>('[data-jump]');
      if (jump && !jump.dataset.bound) {
        jump.dataset.bound = 'true';
        jump.addEventListener('toggle', (e) => {
          if ((e as ToggleEvent).newState !== 'open') return;
          const seen = new Set(getCourseProgress(course).seen);
          jump.querySelectorAll<HTMLElement>('[data-n]').forEach((a) => {
            a.classList.toggle('is-seen', seen.has(Number(a.dataset.n)));
          });
          const current = jump.querySelector<HTMLElement>('[aria-current]');
          if (current) jump.scrollTop = current.offsetTop - jump.clientHeight / 2;
        });
      }
    };

    const onKey = (e: KeyboardEvent) => {
      if (!nav || e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
      const el = document.activeElement as HTMLElement | null;
      // Never hijack typing, or the arrow keys inside an animation figure.
      if (el && (el.closest('.stepframe') || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
      if (e.key === 'ArrowRight' && nav.next) location.href = nav.next;
      if (e.key === 'ArrowLeft' && nav.prev) location.href = nav.prev;
    };

    if (!(window as any).__conceptKeysBound) {
      (window as any).__conceptKeysBound = true;
      document.addEventListener('keydown', onKey);
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>

  <style>
    /* Sits under the masthead so the way on is always one click away, however
       long the explanation runs. */
    .conceptbar {
      position: sticky;
      top: 3.5rem;
      z-index: 15;
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(8px);
    }
    .conceptbar__inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      height: 2.75rem;
      font-size: 0.85rem;
    }
    .conceptbar__where {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
    }
    .conceptbar__where a { color: var(--ink-soft); text-decoration: none; flex-shrink: 0; }
    .conceptbar__where a:hover { color: var(--accent); }
    .conceptbar__section { color: var(--ink-faint); overflow: hidden; text-overflow: ellipsis; }
    .conceptbar__section::before { content: '/'; margin-right: 0.5rem; color: var(--line-strong); }
    @media (max-width: 40rem) { .conceptbar__section { display: none; } }

    .conceptbar__steps { display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
    .conceptbar__step, .conceptbar__count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 2rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--bg-raised);
      color: var(--ink-soft);
      text-decoration: none;
      font: inherit;
      cursor: pointer;
    }
    .conceptbar__step { width: 2.25rem; font-size: 1rem; }
    .conceptbar__count {
      gap: 0.35rem;
      padding: 0 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }
    .conceptbar__count span { font-size: 0.65rem; color: var(--ink-faint); }
    .conceptbar__step:hover, .conceptbar__count:hover { border-color: var(--accent); color: var(--accent); }

    .progress { height: 3px; background: var(--line); }
    .progress__fill { height: 100%; background: var(--accent); transition: width 0.3s ease; }

    .jump {
      position: fixed;
      inset: calc(3.5rem + 2.75rem + 0.5rem) max(1rem, calc((100vw - 78rem) / 2 + 1.25rem)) auto auto;
      width: min(26rem, calc(100vw - 2rem));
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      margin: 0;
      padding: 0.5rem;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      background: var(--bg-raised);
      color: var(--ink);
      box-shadow: var(--shadow);
      font-size: 0.86rem;
    }
    .jump__course {
      display: block;
      padding: 0.4rem 0.6rem 0.6rem;
      color: var(--ink-soft);
      text-decoration: none;
      font-weight: 600;
    }
    .jump__course:hover { color: var(--accent); }
    .jump__section + .jump__section { margin-top: 0.5rem; }
    .jump__title {
      margin: 0;
      padding: 0.4rem 0.6rem 0.2rem;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .jump__list { list-style: none; margin: 0; padding: 0; }
    .jump__link {
      display: flex;
      gap: 0.6rem;
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
      color: var(--ink);
      text-decoration: none;
      line-height: 1.35;
    }
    .jump__link:hover { background: var(--bg-sunken); }
    .jump__link[aria-current] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
    .jump__num { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-faint); padding-top: 0.1rem; }
    /* Concepts already opened, marked from local progress when the menu opens. */
    .jump__link:global(.is-seen) .jump__num { color: var(--ok); }

    .concept { max-width: 62rem; padding-top: 2rem; padding-bottom: 3rem; }

    .concept__badges { display: flex; gap: 0.5rem; margin: 0 0 0.75rem; }

    .concept__key {
      background: var(--accent);
      color: var(--bg-raised);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.12rem 0.4rem;
      border-radius: 4px;
    }

    .concept__assessed {
      border: 1px solid var(--ok);
      color: var(--ok);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
    }

    .concept h1 { margin-bottom: 1.25rem; }

    .prose {
      max-width: var(--measure);
      margin: 2rem auto 0;
      font-size: 1.02rem;
      color: var(--ink);
    }
    .prose :global(h2) { margin-top: 1.8rem; }
    .prose :global(blockquote) {
      margin: 1.4rem 0;
      padding: 0.1rem 0 0.1rem 1rem;
      border-left: 3px solid var(--accent);
      color: var(--ink-soft);
    }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.2rem; }
    .prose :global(li) { margin-bottom: 0.4rem; }

    /* Reference tables are common in this content and are usually wider than the
       reading measure, so they scroll inside their own box rather than pushing
       the page sideways. */
    .prose :global(table) {
      display: block;
      overflow-x: auto;
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.86rem;
      line-height: 1.45;
    }
    .prose :global(thead) { border-bottom: 2px solid var(--line-strong); }
    .prose :global(th), .prose :global(td) {
      padding: 0.45rem 0.75rem 0.45rem 0;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }
    .prose :global(th) {
      font-weight: 600;
      color: var(--ink-soft);
      white-space: nowrap;
    }
    .prose :global(tbody tr:last-child td) { border-bottom: 0; }

    .concept__prereq { max-width: var(--measure); margin: 2rem auto 0; }
    .concept__later-visuals { max-width: var(--measure); margin: 2rem auto 0; }
    .concept__notation { max-width: var(--measure); margin: 2rem auto 0; }

    .concept__quiz { max-width: var(--measure); margin: 2.5rem auto 0; }

    .concept__nav {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }
    .concept__nav .btn { max-width: 48%; }
  </style>
</Base>
