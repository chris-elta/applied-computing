---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ConceptStage from '../../../components/ConceptStage.astro';
import Quiz from '../../../components/Quiz';
import NotationKey from '../../../components/NotationKey.astro';
import Prerequisites from '../../../components/Prerequisites.astro';
import { getCourses, getSteps, conceptPath, coursePath, type Step } from '../../../lib/course';

export async function getStaticPaths() {
  const courses = await getCourses();
  const paths = [];
  for (const course of courses) {
    for (const step of await getSteps(course)) {
      paths.push({ params: { course: course.id, n: String(step.number) }, props: { step } });
    }
  }
  return paths;
}

interface Props { step: Step }

const { step } = Astro.props;
const { concept, course, number, total, prev, next } = step;
const steps = await getSteps(course);
const { Content } = await render(concept);

const section = course.data.sections.find((s) => s.id === concept.data.section);
const prevHref = prev ? conceptPath(course.id, number - 1) : coursePath(course.id);
const nextHref = next ? conceptPath(course.id, number + 1) : coursePath(course.id);
const prerequisites = concept.data.prerequisites.map((p) => {
  const target = p.see ? steps.find((s) => s.concept.id === p.see!.id) : undefined;
  return {
    topic: p.topic,
    explains: p.explains,
    href: target ? conceptPath(course.id, target.number) : undefined,
    seeTitle: target?.concept.data.title,
  };
});
const percent = Math.round((number / total) * 100);
---

<Base title={concept.data.title} description={course.data.summary}>
  <div class="progress" role="progressbar" aria-valuenow={number} aria-valuemin={1} aria-valuemax={total}
       aria-label={`Concept ${number} of ${total}`}>
    <div class="progress__fill" style={`width:${percent}%`} />
  </div>

  <article class="concept shell" data-concept data-course={course.id} data-number={number}
           data-prev={prevHref} data-next={nextHref}>
    <nav class="concept__crumbs">
      <span class="concept__where">
        <a href={coursePath(course.id)}>{course.data.title}</a>
        {section && <span class="concept__section">{section.title}</span>}
        {concept.data.highlight && <span class="concept__key">key concept</span>}
        {concept.data.assessed.length > 0 && (
          <span class="concept__assessed" title={`Assessed in ${concept.data.assessed.join(', ')}`}>assessed</span>
        )}
      </span>
      <span class="concept__count">{number} / {total}</span>
    </nav>

    <h1>{concept.data.title}</h1>

    <ConceptStage visuals={concept.data.visuals} title={concept.data.title} />

    {prerequisites.length > 0 && (
      <div class="concept__prereq">
        <Prerequisites items={prerequisites} assessed={concept.data.assessed} />
      </div>
    )}

    {concept.data.notation.length > 0 && (
      <div class="concept__notation">
        <NotationKey entries={concept.data.notation} />
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {concept.data.questions.length > 0 && (
      <div class="concept__quiz">
        <Quiz client:visible courseId={course.id} conceptNumber={number} questions={concept.data.questions} />
      </div>
    )}

    <nav class="concept__nav">
      <a class="btn" href={prevHref} rel="prev">← {prev ? prev.data.title : 'Contents'}</a>
      <a class="btn btn--primary" href={nextHref} rel="next">{next ? next.data.title : 'Finish course'} →</a>
    </nav>
  </article>

  <script>
    import { markSeen } from '../../../lib/progress';

    // Module scope survives view transitions, so the keydown listener is bound
    // once and simply reads whatever the current concept advertises.
    let nav: { prev: string; next: string } | null = null;

    const init = () => {
      const el = document.querySelector<HTMLElement>('[data-concept]');
      if (!el) { nav = null; return; }
      nav = { prev: el.dataset.prev ?? '', next: el.dataset.next ?? '' };
      markSeen(el.dataset.course ?? '', Number(el.dataset.number));
    };

    const onKey = (e: KeyboardEvent) => {
      if (!nav || e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
      const el = document.activeElement as HTMLElement | null;
      // Never hijack typing, or the arrow keys inside an animation figure.
      if (el && (el.closest('.stepframe') || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
      if (e.key === 'ArrowRight' && nav.next) location.href = nav.next;
      if (e.key === 'ArrowLeft' && nav.prev) location.href = nav.prev;
    };

    if (!(window as any).__conceptKeysBound) {
      (window as any).__conceptKeysBound = true;
      document.addEventListener('keydown', onKey);
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>

  <style>
    .progress { height: 3px; background: var(--line); position: sticky; top: 3.5rem; z-index: 15; }
    .progress__fill { height: 100%; background: var(--accent); transition: width 0.3s ease; }

    .concept { max-width: 62rem; padding-top: 2rem; padding-bottom: 3rem; }

    .concept__crumbs {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
    }
    .concept__where { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
    .concept__where a { color: var(--ink-soft); text-decoration: none; }
    .concept__where a:hover { color: var(--accent); }
    .concept__section { color: var(--ink-faint); }
    .concept__section::before { content: '/'; margin-right: 0.5rem; color: var(--line-strong); }
    .concept__count { font-family: var(--font-mono); color: var(--ink-faint); font-size: 0.78rem; }

    .concept__key {
      background: var(--accent);
      color: var(--bg-raised);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.12rem 0.4rem;
      border-radius: 4px;
    }

    .concept__assessed {
      border: 1px solid var(--ok);
      color: var(--ok);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
    }

    .concept h1 { margin-bottom: 1.25rem; }

    .prose {
      max-width: var(--measure);
      margin: 2rem auto 0;
      font-size: 1.02rem;
      color: var(--ink);
    }
    .prose :global(h2) { margin-top: 1.8rem; }
    .prose :global(blockquote) {
      margin: 1.4rem 0;
      padding: 0.1rem 0 0.1rem 1rem;
      border-left: 3px solid var(--accent);
      color: var(--ink-soft);
    }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.2rem; }
    .prose :global(li) { margin-bottom: 0.4rem; }

    /* Reference tables are common in this content and are usually wider than the
       reading measure, so they scroll inside their own box rather than pushing
       the page sideways. */
    .prose :global(table) {
      display: block;
      overflow-x: auto;
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.86rem;
      line-height: 1.45;
    }
    .prose :global(thead) { border-bottom: 2px solid var(--line-strong); }
    .prose :global(th), .prose :global(td) {
      padding: 0.45rem 0.75rem 0.45rem 0;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }
    .prose :global(th) {
      font-weight: 600;
      color: var(--ink-soft);
      white-space: nowrap;
    }
    .prose :global(tbody tr:last-child td) { border-bottom: 0; }

    .concept__prereq { max-width: var(--measure); margin: 2rem auto 0; }
    .concept__notation { max-width: var(--measure); margin: 2rem auto 0; }

    .concept__quiz { max-width: var(--measure); margin: 2.5rem auto 0; }

    .concept__nav {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }
    .concept__nav .btn { max-width: 48%; }
  </style>
</Base>
