---
import { withBase } from '../lib/course';
---

<button class="search-open" type="button" data-search-open aria-label="Search concepts" aria-keyshortcuts="/ Control+K Meta+K">
  <svg aria-hidden="true" viewBox="0 0 20 20" width="15" height="15"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
  <span class="search-open__label">Search</span>
  <kbd class="search-open__kbd">/</kbd>
</button>

<dialog class="search" data-search data-index={withBase('/search.json')} aria-label="Search concepts">
  <div class="search__bar">
    <input class="search__input" type="search" placeholder="Search every course…" autocomplete="off" spellcheck="false"
           aria-controls="search-results" aria-autocomplete="list" data-search-input />
    <button class="search__close" type="button" data-search-close aria-label="Close search">Esc</button>
  </div>
  <p class="search__status" data-search-status aria-live="polite"></p>
  <ol class="search__results" id="search-results" role="listbox" data-search-results></ol>
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';

  type Entry = { t: string; c: string; ct: string; s?: string; n?: string; b: string; u: string };
  type Indexed = Entry & { tl: string; sl: string; nl: string; bl: string };
  type Hit = { entry: Indexed; score: number };

  const LIMIT = 40;

  // Module scope survives view transitions: the index is fetched once per visit.
  let index: Promise<Indexed[]> | null = null;

  const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const load = (url: string) =>
    (index ??= fetch(url)
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json() as Promise<Entry[]>;
      })
      .then((rows) => rows.map((e) => ({ ...e, tl: fold(e.t), sl: fold(e.s ?? ''), nl: fold(e.n ?? ''), bl: fold(e.b) })))
      .catch((err) => {
        index = null;
        throw err;
      }));

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const atWordStart = (hay: string, i: number) => i === 0 || !/[a-z0-9]/.test(hay[i - 1]);

  /** Every term must appear somewhere; where it appears decides the rank. */
  function search(rows: Indexed[], terms: string[], course: string | undefined): Hit[] {
    const hits: Hit[] = [];
    for (const entry of rows) {
      let score = 0;
      for (const term of terms) {
        const ti = entry.tl.indexOf(term);
        if (ti >= 0) { score += atWordStart(entry.tl, ti) ? 12 : 8; continue; }
        if (entry.nl.includes(term) || entry.sl.includes(term)) { score += 4; continue; }
        const bi = entry.bl.indexOf(term);
        if (bi >= 0) { score += atWordStart(entry.bl, bi) ? 2 : 1; continue; }
        score = 0;
        break;
      }
      if (score === 0) continue;
      if (entry.tl === terms.join(' ')) score += 20;
      if (course && entry.c === course) score += 3;
      hits.push({ entry, score });
    }
    return hits.sort((a, b) => b.score - a.score).slice(0, LIMIT);
  }

  /** Wrap each term's occurrences in <mark>, escaping everything else. */
  function highlight(text: string, terms: string[]): string {
    const folded = fold(text);
    // fold() can change length for some characters; fall back to no marks then.
    if (folded.length !== text.length) return escape(text);
    const marks: [number, number][] = [];
    for (const term of terms) {
      for (let i = folded.indexOf(term); i >= 0; i = folded.indexOf(term, i + term.length)) {
        marks.push([i, i + term.length]);
      }
    }
    marks.sort((a, b) => a[0] - b[0]);
    let out = '';
    let at = 0;
    for (const [start, end] of marks) {
      if (start < at) continue;
      out += escape(text.slice(at, start)) + '<mark>' + escape(text.slice(start, end)) + '</mark>';
      at = end;
    }
    return out + escape(text.slice(at));
  }

  /** A window of the body around the first matching term. */
  function snippet(entry: Indexed, terms: string[]): string {
    const firsts = terms.map((t) => entry.bl.indexOf(t)).filter((i) => i >= 0);
    const at = firsts.length ? Math.min(...firsts) : 0;
    const start = Math.max(0, at - 60);
    const end = Math.min(entry.b.length, start + 180);
    const text = (start > 0 ? '…' : '') + entry.b.slice(start, end).trim() + (end < entry.b.length ? '…' : '');
    return highlight(text, terms);
  }

  const bind = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-search]');
    const opener = document.querySelector<HTMLButtonElement>('[data-search-open]');
    if (!dialog || !opener || dialog.dataset.bound) return;
    dialog.dataset.bound = 'true';

    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = dialog.querySelector<HTMLOListElement>('[data-search-results]')!;
    const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
    let active = -1;
    let seq = 0;

    const items = () => [...list.querySelectorAll<HTMLAnchorElement>('[role="option"]')];

    const setActive = (i: number) => {
      const all = items();
      if (!all.length) { active = -1; input.removeAttribute('aria-activedescendant'); return; }
      active = (i + all.length) % all.length;
      all.forEach((el, j) => el.setAttribute('aria-selected', String(j === active)));
      input.setAttribute('aria-activedescendant', all[active].id);
      all[active].scrollIntoView({ block: 'nearest' });
    };

    const run = async () => {
      const mine = ++seq;
      const terms = fold(input.value).split(/\s+/).filter(Boolean);
      if (!terms.length) {
        list.innerHTML = '';
        status.textContent = 'Search titles, notation and explanations across every course.';
        active = -1;
        return;
      }
      let rows: Indexed[];
      try {
        rows = await load(dialog.dataset.index!);
      } catch {
        status.textContent = 'The search index could not be loaded.';
        return;
      }
      if (mine !== seq) return;

      const course = document.querySelector<HTMLElement>('[data-course]')?.dataset.course;
      const hits = search(rows, terms, course);
      status.textContent = hits.length
        ? `${hits.length === LIMIT ? `Top ${LIMIT}` : hits.length} result${hits.length === 1 ? '' : 's'}`
        : `Nothing matches “${input.value.trim()}”.`;
      list.innerHTML = hits
        .map(({ entry }, i) => `
          <li>
            <a class="search__hit" id="search-hit-${i}" role="option" aria-selected="false" href="${escape(entry.u)}">
              <span class="search__where">${escape(entry.ct)}${entry.s ? ` <span>/ ${escape(entry.s)}</span>` : ''}</span>
              <span class="search__title">${highlight(entry.t, terms)}</span>
              <span class="search__snippet">${snippet(entry, terms)}</span>
            </a>
          </li>`)
        .join('');
      setActive(0);
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.select();
      run();
      load(dialog.dataset.index!).catch(() => {});
    };

    opener.addEventListener('click', open);
    dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    list.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) dialog.close(); });
    list.addEventListener('mousemove', (e) => {
      const hit = (e.target as HTMLElement).closest<HTMLAnchorElement>('[role="option"]');
      if (hit) setActive(items().indexOf(hit));
    });
    input.addEventListener('input', run);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter' && active >= 0) {
        e.preventDefault();
        const href = items()[active].href;
        dialog.close();
        navigate(href);
      }
    });

    (window as any).__openSearch = open;
  };

  if (!(window as any).__searchKeysBound) {
    (window as any).__searchKeysBound = true;
    document.addEventListener('keydown', (e) => {
      const el = document.activeElement as HTMLElement | null;
      const typing = el && (/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) || el.isContentEditable);
      const combo = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      if (combo || (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey)) {
        e.preventDefault();
        (window as any).__openSearch?.();
      }
    });
  }

  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .search-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.1rem;
    padding: 0 0.5rem 0 0.65rem;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    color: var(--ink-faint);
    border-radius: var(--radius);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    min-width: 12rem;
  }
  .search-open:hover { border-color: var(--accent); color: var(--ink-soft); }
  .search-open__label { flex: 1; text-align: left; }
  .search-open__kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 0 0.35rem;
    line-height: 1.4;
  }
  @media (max-width: 40rem) {
    .search-open { min-width: 0; width: 2.1rem; padding: 0; justify-content: center; }
    .search-open__label, .search-open__kbd { display: none; }
  }

  .search {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100vh - 6rem));
    margin: 4.5rem auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .search[open] { display: flex; flex-direction: column; }
  .search::backdrop { background: rgb(0 0 0 / 0.35); backdrop-filter: blur(2px); }

  .search__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
    padding: 0.35rem 0.25rem;
  }
  .search__input:focus { outline: none; }
  .search__input::-webkit-search-cancel-button { display: none; }
  .search__close {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    cursor: pointer;
  }

  .search__status {
    margin: 0;
    padding: 0.5rem 1rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  .search__status:empty { display: none; }

  .search__results {
    list-style: none;
    margin: 0;
    padding: 0 0.4rem 0.4rem;
    overflow-y: auto;
  }
  .search__results :global(.search__hit) {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.7rem;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .search__results :global(.search__hit[aria-selected='true']) { background: var(--accent-soft); }
  .search__results :global(.search__where) {
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }
  .search__results :global(.search__title) { font-weight: 600; }
  .search__results :global(.search__snippet) {
    font-size: 0.84rem;
    color: var(--ink-soft);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search__results :global(mark) {
    background: none;
    color: var(--accent);
    font-weight: 650;
  }
</style>
